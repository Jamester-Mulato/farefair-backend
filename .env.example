# ---------------------------------------------------------------------------
# FareFair API configuration (copy to .env - .env is git-ignored)
# ---------------------------------------------------------------------------

# "pglite" runs an embedded PostgreSQL (WASM) with zero setup.
# "pg" targets a real PostgreSQL server via DATABASE_URL.
DB_DRIVER=pglite

# Embedded PostgreSQL data directory. Defaults to backend/.pglite so data
# survives restarts. Set to empty for an in-memory database.
# PGLITE_DATA_DIR=./.pglite

# Real PostgreSQL connection (used when DB_DRIVER=pg). Replace the password
# placeholder locally; never commit the resolved URL.
# DATABASE_URL=postgres://farefair:your-local-password@localhost:5432/farefair

# Docker Compose requires this value (see docker-compose.yml).
# POSTGRES_PASSWORD=your-local-password

# Password for the seeded demo accounts (admin/analyst/lgu). Optional for
# local development; required when NODE_ENV=production.
# SEED_DEMO_PASSWORD=your-demo-password

# HTTP port.
PORT=4000

# Location of the Flutter asset datasets used to seed the database.
ASSETS_DIR=../assets/data

# Create the schema/seed automatically the first time the API boots.
AUTO_MIGRATE=true
AUTO_SEED=true

# ---------------------------------------------------------------------------
# Hosting
# ---------------------------------------------------------------------------

# Where the admin console lives. Defaults to ../web/admin relative to backend/.
# A hosted image usually copies it next to the app and sets this explicitly.
# ADMIN_DIR=/app/web/admin

# Shared HTTP Basic credential for the browser surface (console, /docs,
# /openapi.json, /v1/auth/*). Set this for any deployment with a public URL:
# the demo password is intentionally easy, and the console can rewrite fares.
# ADMIN_BASIC_AUTH=admin:a-long-random-password

# Trust X-Forwarded-* from the proxy in front of the process. Defaults to
# loopback + private ranges. Set to "false" if the process is exposed directly.
# TRUST_PROXY=loopback, linklocal, uniquelocal

# ---------------------------------------------------------------------------
# Optional trip-analysis narrative provider (OpenAI-compatible chat API).
# Leave all three unset to keep the endpoints rule-based and fully offline:
# no key means no network call. Fare amounts are never generated by the model.
# ---------------------------------------------------------------------------
# One preset is enough: nvidia | groq | cerebras | openrouter | google | ollama
# FAREFAIR_LLM_PROVIDER=nvidia
# FAREFAIR_LLM_API_KEY=nvapi-your-key
#
# Or set the endpoint directly:
# FAREFAIR_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# FAREFAIR_LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# FAREFAIR_LLM_API_KEY=your-provider-key
# FAREFAIR_LLM_TIMEOUT_MS=15000
# FAREFAIR_LLM_JSON_MODE=true
# FAREFAIR_LLM_DISABLED=false
