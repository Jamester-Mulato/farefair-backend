# ---------------------------------------------------------------------------
# FareFair API configuration (copy to .env - .env is git-ignored)
# ---------------------------------------------------------------------------

# "pglite" runs an embedded PostgreSQL (WASM) with zero setup.
# "pg" targets a real PostgreSQL server via DATABASE_URL.
DB_DRIVER=pglite

# Embedded PostgreSQL data directory. Defaults to backend/.pglite so data
# survives restarts. Set to empty for an in-memory database.
# PGLITE_DATA_DIR=./.pglite

# Real PostgreSQL connection (used when DB_DRIVER=pg). Replace the password
# placeholder locally; never commit the resolved URL.
# DATABASE_URL=postgres://farefair:your-local-password@localhost:5432/farefair

# Docker Compose requires this value (see docker-compose.yml).
# POSTGRES_PASSWORD=your-local-password

# Password for the seeded demo accounts (admin/analyst/lgu). Optional for
# local development; required when NODE_ENV=production.
# SEED_DEMO_PASSWORD=your-demo-password

# HTTP port.
PORT=4000

# Location of the Flutter asset datasets used to seed the database.
ASSETS_DIR=../assets/data

# Create the schema/seed automatically the first time the API boots.
AUTO_MIGRATE=true
AUTO_SEED=true
