{
  "baseUrl": "http://localhost:4000",
  "description": "Success-path inputs that exercise every FareFair API operation against a running server. Values with a 'from' object are resolved from an earlier response; the 'example' value is the current live value used by Swagger. Every ACTUAL status in api-inputs.resolved.json is the real HTTP response, not a fabricated one.",
  "notes": [
    "GET operations return 200.",
    "POST /v1/trips and POST /v1/fare/models/train return 201 because they create resources.",
    "Dynamic UUIDs change after npm run db:reset; refresh the examples with npm run api:inputs.",
    "Use cityId=cabadbaran, vehicleId=tricycle, and modelKey=fare-fair-linear for the focus dataset.",
    "Official Cabadbaran routes can be quoted with origin/destination alone; distanceKm is derived from the published fare.",
    "Auth operations sign in first and reuse the bearer token; the matrix signs out at the end."
  ],
  "currentExamples": {
    "cityId": "cabadbaran",
    "vehicleId": "tricycle",
    "slug": "cabadbaran-cabadbaran-tricycle-fare-matrix-2026",
    "modelKey": "fare-fair-linear",
    "versionId": "132d87ea-6c2a-4469-bf33-43722f6658cf",
    "quoteId": "984aeed6-2da6-44bc-8f6b-e2e8e0c31358",
    "tripId": "d9cab424-e233-4f99-98b2-38213ed6ed31",
    "anomalyId": "7daefbf5-bbe8-4006-a5aa-ba50c59f4412"
  },
  "operations": [
    {
      "id": "health",
      "method": "GET",
      "path": "/health",
      "expect": 200,
      "inputs": {}
    },
    {
      "id": "login",
      "method": "POST",
      "path": "/v1/auth/login",
      "expect": 200,
      "body": {
        "login": "admin@farefair.local",
        "password": "farefair"
      }
    },
    {
      "id": "auth-me",
      "method": "GET",
      "path": "/v1/auth/me",
      "expect": 200,
      "auth": {
        "from": "login",
        "field": "token"
      }
    },
    {
      "id": "auth-accounts",
      "method": "GET",
      "path": "/v1/auth/accounts",
      "expect": 200,
      "auth": {
        "from": "login",
        "field": "token"
      }
    },
    {
      "id": "admin-fare-matrix-put",
      "method": "PUT",
      "path": "/v1/admin/cities/{cityId}/fare-matrix/{vehicleId}",
      "expect": 200,
      "pathParams": {
        "cityId": "cabadbaran",
        "vehicleId": "tricycle"
      },
      "body": {
        "baseFare": 13,
        "baseDistanceKm": 1,
        "perKmRate": 2,
        "minFare": 13,
        "maxCustomary": 75,
        "typicalCapacity": 4,
        "active": true
      },
      "auth": {
        "from": "login",
        "field": "token"
      }
    },
    {
      "id": "admin-fare-matrix-patch",
      "method": "PATCH",
      "path": "/v1/admin/cities/{cityId}/fare-matrix/{vehicleId}",
      "expect": 200,
      "pathParams": {
        "cityId": "cabadbaran",
        "vehicleId": "tricycle"
      },
      "body": {
        "baseFare": 13,
        "baseDistanceKm": 1,
        "perKmRate": 2,
        "minFare": 13,
        "maxCustomary": 75,
        "typicalCapacity": 4,
        "active": true
      },
      "auth": {
        "from": "login",
        "field": "token"
      }
    },
    {
      "id": "admin-fare-route-put",
      "method": "PUT",
      "path": "/v1/admin/cities/{cityId}/fare-routes/{rowNumber}",
      "expect": 200,
      "pathParams": {
        "cityId": "cabadbaran",
        "rowNumber": 4
      },
      "query": {
        "vehicleId": "tricycle"
      },
      "body": {
        "regularFare": 50,
        "discountedFare": 40,
        "remark": "",
        "bidirectional": true
      },
      "auth": {
        "from": "login",
        "field": "token"
      }
    },
    {
