      "pathParams": {
        "cityId": "cabadbaran"
      },
      "body": {},
      "auth": {
        "from": "login",
        "field": "token"
      }
    },
    {
      "id": "admin-audit",
      "method": "POST",
      "path": "/v1/admin/audit",
      "expect": 201,
      "body": {
        "action": "console.check",
